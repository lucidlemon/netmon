<Window x:Class="NetMonGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="NetMon — which connection is better?"
        Icon="Assets/icon.ico"
        Height="900" Width="1360" MinHeight="220" MinWidth="260"
        Background="#FF1A1A1E" Foreground="#FFE6E6E6"
        FontFamily="Consolas" FontSize="13"
        WindowStyle="None" ResizeMode="CanResize"
        SizeChanged="MainWindow_SizeChanged">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FF26262C"/>
            <Setter Property="Foreground" Value="#FFCFCFCF"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#FF3A3A42"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Foreground" Value="#FFE6E6E6"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FF33333C"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="Button" x:Key="PreferButtonStyle">
            <Setter Property="Background" Value="#FF2E3B4E"/>
            <Setter Property="Foreground" Value="#FFCFE3FF"/>
            <Setter Property="BorderBrush" Value="#FF4A6482"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SegmentOptionStyle" TargetType="RadioButton">
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Foreground" Value="#FF8A8A92"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FF2E3B4E"/>
                                <Setter Property="Foreground" Value="#FFCFE3FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom title bar buttons (WindowStyle="None" + WindowChrome below removes the native
             ones). Two separate complete styles rather than one shared base + override, since a
             ControlTemplate.Trigger targeting the inner "Bg" border by name would otherwise fight
             a Style.Trigger trying to override Background through TemplateBinding. -->
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFCFCFCF"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FF2A2A30"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseCaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFCFCFCF"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FFE0505A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The default ComboBox chrome (closed box) and the ComboBoxItem popup both draw against
             hardcoded theme/system brushes (white popup, glossy light chrome) that Background/
             Foreground set on the ComboBox element itself don't reach - those only bind partway
             into the default template. Both need a full custom ControlTemplate, same as
             PreferButtonStyle/SegmentOptionStyle above, to actually render dark. AllowsTransparency
             is explicitly off on the popup too, since a transparent/layered popup window can pick up
             Windows 11's Mica/acrylic backdrop blur, which washed out the selected-row highlight. -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Foreground" Value="#FFE6E6E6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="#FF26262C" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF33333C"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF2E3B4E"/>
                                <Setter Property="Foreground" Value="#FFCFE3FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FF26262C"/>
            <Setter Property="Foreground" Value="#FFE6E6E6"/>
            <Setter Property="BorderBrush" Value="#FF3A3A42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#FF26262C" BorderBrush="#FF3A3A42" BorderThickness="1" CornerRadius="3"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <Path Fill="{TemplateBinding Foreground}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Margin="0,0,10,0" Data="M 0 0 L 4 5 L 8 0 Z"/>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="False" Focusable="False" PopupAnimation="None">
                                <Border x:Name="DropDownBorder" Background="#FF1F1F24" BorderBrush="#FF3A3A42" BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}" SnapsToDevicePixels="True">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thin overlay scrollbar: invisible until the mouse is over it (near the right edge),
             mouse wheel scrolling works regardless. Styling ScrollBar directly (rather than giving
             ScrollViewer a custom template) reuses ScrollViewer's own default template/PART wiring,
             so none of its built-in scrolling behavior needs to be reimplemented. -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#FF5A5A64" CornerRadius="3" Margin="1,0"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <ItemsPanelTemplate x:Key="UniformRowPanelTemplate">
            <UniformGrid Rows="1"/>
        </ItemsPanelTemplate>

        <DataTemplate x:Key="AdapterCardTemplate">
            <Border Background="#FF1F1F24" BorderBrush="#FF3A3A42" BorderThickness="1" CornerRadius="8"
                    Margin="6" Padding="16">
                <StackPanel>
                    <!-- name / marker / OS badge -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Marker}" Foreground="Gold" FontWeight="Bold" FontSize="15"
                                   Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <Border Width="10" Height="10" CornerRadius="5" Background="{Binding Color}"
                                Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="15"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Description}" Foreground="#FF8A8A92" FontSize="11"
                               Margin="0,3,0,14" TextTrimming="CharacterEllipsis"/>

                    <!-- current latency, front and center -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,2">
                        <TextBlock Text="{Binding NowMs}" FontSize="42" FontWeight="Bold" Foreground="{Binding NowBrush}"/>
                        <TextBlock Text="ms" FontSize="16" Foreground="{Binding NowBrush}"
                                   VerticalAlignment="Bottom" Margin="4,0,0,8"/>
                    </StackPanel>
                    <TextBlock Text="ping right now" Foreground="#FF6E6E76" FontSize="10"
                               HorizontalAlignment="Center" Margin="0,0,0,16"/>

                    <!-- 30s / 1h / session breakdown -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="1" Text="ping / jitter" Foreground="#FF6E6E76" FontSize="10"
                                   Margin="0,0,0,4"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="loss" Foreground="#FF6E6E76" FontSize="10"
                                   HorizontalAlignment="Right" Margin="0,0,0,4"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="30s" Foreground="#FF6E6E76" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,10,4"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Win30}" Foreground="{Binding Win30Brush}"
                                   FontSize="12" Margin="0,0,0,4"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Loss30}" Foreground="{Binding Loss30Brush}"
                                   FontSize="12" HorizontalAlignment="Right" Margin="0,0,0,4"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="1h" Foreground="#FF6E6E76" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,10,4"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Win1h}" Foreground="{Binding Win1hBrush}"
                                   FontSize="12" Margin="0,0,0,4"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Loss1h}" Foreground="{Binding Loss1hBrush}"
                                   FontSize="12" HorizontalAlignment="Right" Margin="0,0,0,4"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="session" Foreground="#FF6E6E76" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Session}" Foreground="{Binding SessionBrush}"
                                   FontSize="12"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding LossSession}" Foreground="{Binding LossSessionBrush}"
                                   FontSize="12" HorizontalAlignment="Right"/>
                    </Grid>

                    <Button Content="Prefer this adapter" Style="{StaticResource PreferButtonStyle}"
                            HorizontalAlignment="Stretch" Margin="0,16,0,0" Padding="8,6"
                            Tag="{Binding}" Click="PreferButton_Click"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Lighter-weight card used for extra (non-default) targets: no Prefer button, since
             preferring an adapter changes real OS routing metrics and that's a default-target
             concept, not something tied to a specific comparison target like a game server. -->
        <DataTemplate x:Key="CompactAdapterCardTemplate">
            <Border Background="#FF1F1F24" BorderBrush="#FF3A3A42" BorderThickness="1" CornerRadius="8"
                    Margin="6" Padding="14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Marker}" Foreground="Gold" FontWeight="Bold" FontSize="13"
                                   Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <Border Width="9" Height="9" CornerRadius="4.5" Background="{Binding Color}"
                                Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,2">
                        <TextBlock Text="{Binding NowMs}" FontSize="30" FontWeight="Bold" Foreground="{Binding NowBrush}"/>
                        <TextBlock Text="ms" FontSize="13" Foreground="{Binding NowBrush}"
                                   VerticalAlignment="Bottom" Margin="4,0,0,5"/>
                    </StackPanel>
                    <TextBlock Text="ping right now" Foreground="#FF6E6E76" FontSize="9"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="session " Foreground="#FF6E6E76" FontSize="11"/>
                        <TextBlock Text="{Binding Session}" Foreground="{Binding SessionBrush}" FontSize="11"/>
                        <TextBlock Text="   loss " Foreground="#FF6E6E76" FontSize="11" Margin="8,0,0,0"/>
                        <TextBlock Text="{Binding LossSession}" Foreground="{Binding LossSessionBrush}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Used only below CompactWidthThreshold (see MainWindow_SizeChanged): a one-column,
             text-first card with dot-leader stat rows and a tiny fixed-size sparkline, for windows
             too narrow to fit the full card grid and charts. -->
        <DataTemplate x:Key="MinimalAdapterCardTemplate">
            <Border Background="#FF1F1F24" BorderBrush="#FF3A3A42" BorderThickness="1" CornerRadius="6"
                    Margin="0,0,0,8" Padding="10,8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="{Binding Marker}" Foreground="Gold" FontWeight="Bold" FontSize="13"
                                   Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <Border Width="8" Height="8" CornerRadius="4" Background="{Binding Color}"
                                Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <DockPanel Margin="0,0,0,2">
                        <TextBlock DockPanel.Dock="Left" Text="Ping" Foreground="#FF8A8A92" FontSize="11"/>
                        <TextBlock DockPanel.Dock="Right" Foreground="{Binding NowBrush}" FontSize="11" FontWeight="SemiBold">
                            <Run Text="{Binding NowMs, Mode=OneWay}"/><Run Text=" ms"/>
                        </TextBlock>
                        <TextBlock Text="......................................................................"
                                   Foreground="#FF3A3A42" FontSize="11" Margin="4,0" ClipToBounds="True"/>
                    </DockPanel>

                    <DockPanel Margin="0,0,0,2">
                        <TextBlock DockPanel.Dock="Left" Text="Jitter" Foreground="#FF8A8A92" FontSize="11"/>
                        <TextBlock DockPanel.Dock="Right" Foreground="#FFCFCFCF" FontSize="11" FontWeight="SemiBold">
                            <Run Text="{Binding NowJitterMs, Mode=OneWay}"/><Run Text=" ms"/>
                        </TextBlock>
                        <TextBlock Text="......................................................................"
                                   Foreground="#FF3A3A42" FontSize="11" Margin="4,0" ClipToBounds="True"/>
                    </DockPanel>

                    <DockPanel Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left" Text="Loss (60s)" Foreground="#FF8A8A92" FontSize="11"/>
                        <TextBlock DockPanel.Dock="Right" Foreground="{Binding Loss60Brush}" FontSize="11" FontWeight="SemiBold"
                                   Text="{Binding Loss60, Mode=OneWay}"/>
                        <TextBlock Text="......................................................................"
                                   Foreground="#FF3A3A42" FontSize="11" Margin="4,0" ClipToBounds="True"/>
                    </DockPanel>

                    <Border Background="#FF16161A" BorderBrush="#FF2A2A30" BorderThickness="1">
                        <Canvas Height="26" ClipToBounds="True" SizeChanged="MiniSparkCanvas_SizeChanged">
                            <Polyline Points="{Binding JitterSpark}" Stroke="#FF6E6E76" StrokeThickness="1.2"/>
                            <Polyline Points="{Binding PingSpark}" Stroke="{Binding Color}" StrokeThickness="1.4"/>
                        </Canvas>
                    </Border>
                    <TextBlock Text="last 60s — ping / jitter" Foreground="#FF6E6E76" FontSize="9" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar (WindowStyle="None" removed the native one). The whole strip is a
             WindowChrome drag region by default; only the button panel opts out via
             IsHitTestVisibleInChrome so clicks reach the buttons instead of starting a drag. -->
        <Border Grid.Row="0" Background="#FF16161A" BorderBrush="#FF2A2A30" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                    <Image Source="Assets/icon.ico" Width="16" Height="16" Margin="0,0,8,0"/>
                    <TextBlock Text="NetMon" FontSize="12" Foreground="#FF8A8A92" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeButton" Content="&#xE921;" Style="{StaticResource CaptionButtonStyle}"
                            Click="MinimizeButton_Click" ToolTip="Minimize"/>
                    <Button x:Name="CloseButton" Content="&#xE8BB;" Style="{StaticResource CloseCaptionButtonStyle}"
                            Click="CloseButton_Click" ToolTip="Close"/>
                </StackPanel>
            </Grid>
        </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <!-- Fixed pixel heights so the charts have real height to draw into, but that also
                 means collapsing their Border content (compact mode) does NOT free this space -
                 a Grid row's size is independent of its content's Visibility unless the row itself
                 is resized too. MainWindow.ApplyCompactMode zeroes these out via x:Name when
                 compact, which is what actually fixes the empty-scroll-area bug this caused. -->
            <RowDefinition x:Name="LatencyChartRow" Height="200"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition x:Name="JitterChartRow" Height="200"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel x:Name="HeaderPanel" Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="NetMon" FontSize="20" FontWeight="Bold" Foreground="#FF8FD3FF" VerticalAlignment="Center"/>
                <TextBlock Text="which connection is better for gaming?" FontSize="12" Foreground="#FF8A8A92" Margin="10,4,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <TextBlock Text="Target:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#FF8A8A92"/>
                <ComboBox x:Name="TargetPresetCombo" Width="250" VerticalAlignment="Center" Margin="0,0,6,0"
                          Background="#FF26262C" Foreground="#FFE6E6E6" BorderBrush="#FF3A3A42"
                          SelectionChanged="TargetPresetCombo_SelectionChanged">
                    <ComboBoxItem Content="Cloudflare (1.1.1.1)" Tag="1.1.1.1"/>
                    <ComboBoxItem Content="Google (8.8.8.8)" Tag="8.8.8.8"/>
                    <ComboBoxItem Content="Dota 2 EU East (Vienna)" Tag="185.25.182.1"/>
                    <ComboBoxItem Content="Dota 2 EU West (Luxembourg)" Tag="146.66.158.1"/>
                    <ComboBoxItem Content="Dota 2 Russia (Stockholm)" Tag="185.25.180.1"/>
                    <ComboBoxItem Content="Dota 2 Europe East (Vienna, Austria)" Tag="146.66.155.36"/>
                    <ComboBoxItem Content="Dota 2 Europe West (Amsterdam, Netherlands)" Tag="155.133.248.53"/>
                    <ComboBoxItem Content="Dota 2 Europe West (Madrid, Spain)" Tag="155.133.246.66"/>
                    <ComboBoxItem Content="Dota 2 Europe (Warsaw, Poland)" Tag="155.133.248.53"/>
                    <ComboBoxItem Content="Dota 2 Europe (Stockholm, Sweden)" Tag="155.133.246.66"/>
                    <ComboBoxItem Content="Dota 2 US West (Bellevue, WA)" Tag="155.133.253.38"/>
                    <ComboBoxItem Content="Dota 2 US West (Los Angeles, CA)" Tag="155.133.232.98"/>
                    <ComboBoxItem Content="Dota 2 US West (Salt Lake City, UT)" Tag="155.133.235.34"/>
                    <ComboBoxItem Content="Dota 2 West Asia (Bengaluru, India)" Tag="155.133.233.99"/>
                    <ComboBoxItem Content="Dota 2 East Asia (Tokyo, Japan)" Tag="155.133.239.25"/>
                    <ComboBoxItem Content="Dota 2 East Asia (Chiyoda, Japan)" Tag="155.133.245.35"/>
                    <ComboBoxItem Content="Dota 2 South East Asia (Singapore)" Tag="103.10.124.44"/>
                    <ComboBoxItem Content="Dota 2 Oceania (Sydney, Australia)" Tag="103.10.125.146"/>
                    <ComboBoxItem Content="Dota 2 Africa (Johannesburg, South Africa)" Tag="155.133.238.163"/>
                    <ComboBoxItem x:Name="CustomTargetOption" Content="Custom…"/>
                </ComboBox>
                <TextBox x:Name="TargetBox" Width="110" Text="1.1.1.1" Visibility="Collapsed" VerticalContentAlignment="Center"
                         Background="#FF26262C" Foreground="#FFE6E6E6" BorderBrush="#FF3A3A42" Padding="4,3" Margin="0,0,6,0"/>
                <Button x:Name="ApplyTargetButton" Content="Apply" Margin="0,0,18,0" Padding="16,3" Visibility="Collapsed"
                        Style="{StaticResource PreferButtonStyle}" Click="ApplyTargetButton_Click"/>
                <CheckBox x:Name="PerProcessCheckBox" Content="Per-process bandwidth" VerticalAlignment="Center"
                          Foreground="#FF8A8A92" Margin="0,0,18,0"
                          ToolTip="Needs administrator rights — NetMon will restart elevated if it isn't already."
                          Checked="PerProcessCheckBox_Checked" Unchecked="PerProcessCheckBox_Unchecked"/>
                <TextBlock Text="Session:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#FF8A8A92"/>
                <TextBlock x:Name="SessionTimeText" Text="00:00:00" VerticalAlignment="Center" FontWeight="SemiBold"/>
            </StackPanel>
        </DockPanel>

        <DockPanel Grid.Row="1" Margin="0,0,0,8" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" x:Name="StatusText" Text="Discovering network adapters…"
                       Foreground="#FF8A8A92"/>
            <TextBlock DockPanel.Dock="Right" x:Name="UpdateStatusText" Text=""
                       Foreground="#FF8FD3FF" Visibility="Collapsed"/>
            <TextBlock DockPanel.Dock="Right" x:Name="ApiWarningText" Text="" Margin="0,0,14,0"
                       Foreground="#FFE8D34F" Visibility="Collapsed"
                       ToolTip="The Stream Deck plugin (and any other local tool) reads live stats from this API - it won't be able to connect until only one NetMon instance is running."/>
        </DockPanel>

        <!-- Adapter cards - one per active connection, always splitting the available width evenly -->
        <ItemsControl Grid.Row="2" x:Name="AdapterCards" VerticalAlignment="Top"
                      ItemsPanel="{StaticResource UniformRowPanelTemplate}"
                      ItemTemplate="{StaticResource AdapterCardTemplate}"/>

        <!-- Shown instead of AdapterCards below CompactWidthThreshold - see MainWindow_SizeChanged. -->
        <ItemsControl Grid.Row="2" x:Name="CompactAdapterCards" VerticalAlignment="Top" Visibility="Collapsed"
                      ItemTemplate="{StaticResource MinimalAdapterCardTemplate}"/>

        <TextBlock x:Name="LegendNoteText" Grid.Row="3" Margin="2,8,0,0" Foreground="#FF6E6E76" FontSize="11">
            ★ = currently the better connection (lowest session avg/jitter/loss score)    [OS] = the connection Windows is currently routing internet traffic through &#8212; these can disagree.
        </TextBlock>

        <!-- Latency chart -->
        <Border x:Name="LatencyChartBorder" Grid.Row="4" Margin="0,12,0,0" Background="#FF1F1F24" BorderBrush="#FF3A3A42" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>
                <Canvas x:Name="LatencyChartCanvas" Grid.Column="0" Margin="8" ClipToBounds="True"
                        SizeChanged="ChartCanvas_SizeChanged"/>
                <StackPanel x:Name="LatencyLegendPanel" Grid.Column="1" Margin="4,10,10,10"/>
            </Grid>
        </Border>

        <TextBlock x:Name="LatencyCaptionText" Grid.Row="5" Margin="2,6,0,0" Foreground="#FF6E6E76" FontSize="11"
                    Text="Latency over the last 2 minutes, per adapter (ms)."/>

        <!-- Jitter chart -->
        <Border x:Name="JitterChartBorder" Grid.Row="6" Margin="0,12,0,0" Background="#FF1F1F24" BorderBrush="#FF3A3A42" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>
                <Canvas x:Name="JitterChartCanvas" Grid.Column="0" Margin="8" ClipToBounds="True"
                        SizeChanged="ChartCanvas_SizeChanged"/>
                <StackPanel x:Name="JitterLegendPanel" Grid.Column="1" Margin="4,10,10,10"/>
            </Grid>
        </Border>

        <TextBlock x:Name="JitterCaptionText" Grid.Row="7" Margin="2,6,0,0" Foreground="#FF6E6E76" FontSize="11"
                    Text="Jitter over the last 2 minutes, per adapter (ms) — change from one ping to the next."/>

        <!-- Extra targets: compare against something other than the default target, e.g. a
             game server's datacenter, side by side with the same adapters above. -->
        <Border x:Name="ExtraTargetsBorder" Grid.Row="8" Margin="0,16,0,0" Background="#FF1F1F24" BorderBrush="#FF3A3A42" BorderThickness="1" Padding="12">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="Extra targets:" Foreground="#FF8FD3FF" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,14,0"/>
                <TextBlock DockPanel.Dock="Left" Text="Label" Foreground="#FF8A8A92" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="NewTargetLabelBox" DockPanel.Dock="Left" Width="140" VerticalContentAlignment="Center"
                         Background="#FF26262C" Foreground="#FFE6E6E6" BorderBrush="#FF3A3A42" Padding="4,3" Margin="0,0,14,0"/>
                <TextBlock DockPanel.Dock="Left" Text="Host / IP" Foreground="#FF8A8A92" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="NewTargetHostBox" DockPanel.Dock="Left" Width="160" VerticalContentAlignment="Center"
                         Background="#FF26262C" Foreground="#FFE6E6E6" BorderBrush="#FF3A3A42" Padding="4,3" Margin="0,0,10,0"/>
                <Button DockPanel.Dock="Left" Content="Add target" Style="{StaticResource PreferButtonStyle}"
                        Padding="16,3" Click="AddTargetButton_Click"/>
                <TextBlock DockPanel.Dock="Right" Foreground="#FF6E6E76" FontSize="11" VerticalAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="380"
                           Text="e.g. a game server's datacenter IP, to compare against what the game itself reports — ICMP ping to it won't always match a game's own UDP-based ping, but it's a useful signal."/>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="9" x:Name="ExtraTargetsHost" Margin="0,12,0,0"/>

        <!-- Per-process bandwidth (only visible once enabled) -->
        <Border Grid.Row="10" x:Name="ProcessPanel" Margin="0,12,0,0" Background="#FF1F1F24"
                BorderBrush="#FF3A3A42" BorderThickness="1" Visibility="Collapsed">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="4,0,0,6" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Foreground="#FF8FD3FF" FontWeight="SemiBold" VerticalAlignment="Center"
                               Text="Top 10 network processes — what might be causing the lag"/>
                    <Border DockPanel.Dock="Right" Background="#FF16161A" BorderBrush="#FF3A3A42" BorderThickness="1"
                            CornerRadius="5" Padding="2">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="SortByCurrentRadio" Content="Current" GroupName="ProcessSortMode"
                                         IsChecked="True" Style="{StaticResource SegmentOptionStyle}"
                                         Checked="ProcessSortMode_Checked"
                                         ToolTip="Rank by current send+receive rate"/>
                            <RadioButton x:Name="SortByAvg30Radio" Content="30s avg" GroupName="ProcessSortMode"
                                         Style="{StaticResource SegmentOptionStyle}"
                                         Checked="ProcessSortMode_Checked"
                                         ToolTip="Rank by average rate over the last 30 seconds - catches a spike that isn't showing right now"/>
                            <RadioButton x:Name="SortByTotalRadio" Content="Total" GroupName="ProcessSortMode"
                                         Style="{StaticResource SegmentOptionStyle}"
                                         Checked="ProcessSortMode_Checked"
                                         ToolTip="Rank by total data moved this session"/>
                        </StackPanel>
                    </Border>
                </DockPanel>
                <DataGrid Grid.Row="1" x:Name="ProcessGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          Background="Transparent" BorderThickness="0" RowBackground="Transparent"
                          AlternatingRowBackground="#FF232328" HeadersVisibility="Column" GridLinesVisibility="None"
                          CanUserAddRows="False" CanUserResizeRows="False" CanUserSortColumns="False"
                          SelectionMode="Single" RowHeight="28">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="240">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="↓ Down" Binding="{Binding DownDisplay}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="↑ Up" Binding="{Binding UpDisplay}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Rate" Binding="{Binding RateTotalDisplay}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="30s avg" Binding="{Binding Avg30Display}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Session data" Binding="{Binding SessionDataDisplay}" Width="*" MinWidth="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
    </ScrollViewer>
    </Grid>
</Window>
